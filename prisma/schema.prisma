generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String?   @unique
  passwordHash String
  goldCoins    Int       @default(0)
  sweepsCoins  Int       @default(0)
  lastSpinAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  transactions           Transaction[]
  rewardTransactions     RewardTransaction[]
  verification           Verification?
  tournamentLeaderboard  TournamentLeaderboard[]
  tournamentParticipants TournamentParticipant[]
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  code          String   @unique
  paymentId     String?  @unique
  amountCents   Int
  goldCoins     Int
  sweepsCoins   Int
  paymentMethod String
  status        String   @default("waiting") // waiting | confirmed | rejected
  reason        String?
  cardLast4     String?
  cardType      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model RewardTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  code        String   @unique
  source      String // email_verification | phone_verification | kyc_verification
  goldCoins   Int
  sweepsCoins Int
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Verification {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id])
  emailOtp           String?
  emailOtpExpiresAt  DateTime?
  emailVerifiedAt    DateTime?
  emailRewardClaimed Boolean   @default(false)
  phoneNumber        String?
  phoneOtp           String?
  phoneOtpExpiresAt  DateTime?
  phoneVerifiedAt    DateTime?
  phoneRewardClaimed Boolean   @default(false)
  kycFirstName       String?
  kycLastName        String?
  kycDateOfBirth     String?
  kycAddress1        String?
  kycAddress2        String?
  kycCity            String?
  kycState           String?
  kycCountry         String?
  kycZip             String?
  kycVerifiedAt      DateTime?
  kycRewardClaimed   Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Tournament {
  id                 String    @id @default(cuid())
  name               String
  bannerUrl          String
  startTime          DateTime
  endTime            DateTime
  tournamentType     String    // multiplier | winning | wagered | referral | freespin
  coinMode           String    // gc | sc | gc_sc
  prizePoolGc        Float     @default(0)
  prizePoolSc        Float     @default(0)
  prizePoolRates     Json?     // [{rank, gcValue, scValue}]
  description        String?
  status             String    @default("commingup") // active | commingup | ended | canceled
  winners            Int       @default(20)
  isDeleted          Boolean   @default(false)
  isPrizeDistributed Boolean   @default(false)
  prizeDistributedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  leaderboard  TournamentLeaderboard[]
  participants TournamentParticipant[]
  games        TournamentGame[]

  @@index([status, isDeleted, startTime])
  @@index([status, isDeleted])
}

model TournamentGame {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  gameId       String
  gameName     String
  thumbnail    String?

  @@index([tournamentId])
}

model TournamentParticipant {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  joinedAt     DateTime   @default(now())

  @@unique([tournamentId, userId])
  @@index([tournamentId])
  @@index([userId])
}

model TournamentLeaderboard {
  id               String     @id @default(cuid())
  tournamentId     String
  tournament       Tournament @relation(fields: [tournamentId], references: [id])
  userId           String
  user             User       @relation(fields: [userId], references: [id])
  place            Int        @default(0)
  prevPlace        Int        @default(0)
  points           Float      @default(0)
  gcPrize          Float      @default(0)
  scPrize          Float      @default(0)
  gcBet            Float      @default(0)
  scBet            Float      @default(0)
  availableToClaim Boolean    @default(false)
  isClaimed        Boolean    @default(false)
  claimedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@unique([tournamentId, userId])
  @@index([tournamentId, place])
  @@index([userId, availableToClaim, isClaimed])
}
