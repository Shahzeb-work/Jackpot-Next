generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String?   @unique
  passwordHash String
  goldCoins    Int       @default(0)
  sweepsCoins  Int       @default(0)
  lastSpinAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  transactions       Transaction[]
  rewardTransactions RewardTransaction[]
  verification       Verification?
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  code          String   @unique
  paymentId     String?  @unique
  amountCents   Int
  goldCoins     Int
  sweepsCoins   Int
  paymentMethod String
  status        String   @default("waiting") // waiting | confirmed | rejected
  reason        String?
  cardLast4     String?
  cardType      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model RewardTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  code        String   @unique
  source      String // email_verification | phone_verification | kyc_verification
  goldCoins   Int
  sweepsCoins Int
  createdAt   DateTime @default(now())

  @@index([userId])
}

model Verification {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id])
  emailOtp           String?
  emailOtpExpiresAt  DateTime?
  emailVerifiedAt    DateTime?
  emailRewardClaimed Boolean   @default(false)
  phoneNumber        String?
  phoneOtp           String?
  phoneOtpExpiresAt  DateTime?
  phoneVerifiedAt    DateTime?
  phoneRewardClaimed Boolean   @default(false)
  kycFirstName       String?
  kycLastName        String?
  kycDateOfBirth     String?
  kycAddress1        String?
  kycAddress2        String?
  kycCity            String?
  kycState           String?
  kycCountry         String?
  kycZip             String?
  kycVerifiedAt      DateTime?
  kycRewardClaimed   Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}
